<!-- SHADOW CITY — keep engine classes that are only used indirectly.
     Managed code stripping removes MeshCollider because nothing references it
     directly (GameObject.CreatePrimitive adds it reflectively for
     Plane/Sphere/Cylinder) → "class 'MeshCollider' doesn't exist" in builds
     and the ground loses its collider. Preserve the physics + particle
     modules wholesale (tiny size cost, total safety). -->
<linker>
  <assembly fullname="UnityEngine.PhysicsModule" preserve="all" />
  <assembly fullname="UnityEngine.ParticleSystemModule" preserve="all" />
  <assembly fullname="UnityEngine.AudioModule" preserve="all" />
</linker>
